# TMDB_API_KEY: Chiave API v3 di The Movie Database (TMDB) per il catalogo film e serie TV.
# Configurabile dal pannello Secrets in AI Studio o tramite GitHub Actions Secrets.
TMDB_API_KEY=MY_TMDB_API_KEY

# SIMKL_CLIENT_ID: Client ID pubblico ufficiale Simkl API v2 (OAuth2 Device Flow).
# Configurabile dal pannello Secrets in AI Studio senza inserire client_secret nell'APK.
SIMKL_CLIENT_ID=MY_SIMKL_CLIENT_ID
